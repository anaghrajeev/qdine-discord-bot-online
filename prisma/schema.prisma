generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Use PostgreSQL provided by Neon (https://neon.tech/)
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(uuid())
  discord_user_id String   @unique
  username        String
  display_name    String?
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  work_sessions   WorkSession[]
  breaks          Break[]
  standups        Standup[]
  assigned_bugs   Bug[] @relation("BugAssignee")
  reported_bugs   Bug[] @relation("BugReporter")
}

model WorkSession {
  id               String   @id @default(uuid())
  user_id          String
  user             User     @relation(fields: [user_id], references: [id])
  channel_id       String
  start_time       DateTime
  end_time         DateTime?
  duration_seconds Int?
  status           String   // ACTIVE, COMPLETED, INTERRUPTED
  goal             String?  // The focus goal for this session
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  breaks           Break[]
}

model Break {
  id               String      @id @default(uuid())
  user_id          String
  user             User        @relation(fields: [user_id], references: [id])
  session_id       String
  session          WorkSession @relation(fields: [session_id], references: [id])
  start_time       DateTime
  end_time         DateTime?
  duration_seconds Int?
  created_at       DateTime    @default(now())
}

model Settings {
  id                 String   @id @default(uuid())
  guild_id           String   @unique
  working_channel_id String?
  report_channel_id  String?
  admin_role_id      String?
  timezone           String   @default("Asia/Kolkata")
  daily_report_time  String   @default("18:00")
  weekly_report_day  String   @default("FRIDAY")
  weekly_report_time String   @default("18:00")
  monthly_reward     String?  // Text for the monthly leaderboard reward
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
}

model Standup {
  id           String   @id @default(uuid())
  user_id      String
  user         User     @relation(fields: [user_id], references: [id])
  date         DateTime @default(now())
  yesterday    String   @db.Text
  today        String   @db.Text
  blockers     String   @db.Text
  created_at   DateTime @default(now())
}

model Bug {
  id          Int      @id @default(autoincrement())
  description String
  assignee_id String
  assignee    User     @relation("BugAssignee", fields: [assignee_id], references: [id])
  reporter_id String
  reporter    User     @relation("BugReporter", fields: [reporter_id], references: [id])
  status      String   @default("OPEN") // OPEN, COMPLETED
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}
